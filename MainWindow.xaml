<Window x:Class="ClashSpeedTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash 节点测速"
        Height="760" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        FontFamily="Segoe UI, Microsoft YaHei"
        Foreground="#1F2328"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ============ 通用 ============ -->
        <SolidColorBrush x:Key="BgWindow"  Color="#F6F8FA"/>
        <SolidColorBrush x:Key="BgCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubtle"  Color="#F6F8FA"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="BorderMid"  Color="#AFB8C1"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#1F2328"/>
        <SolidColorBrush x:Key="FgSecondary" Color="#656D76"/>
        <SolidColorBrush x:Key="Accent"    Color="#0969DA"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#DDEBF6"/>
        <SolidColorBrush x:Key="Green"     Color="#1A7F37"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#DAFBE1"/>
        <SolidColorBrush x:Key="Orange"    Color="#9A6700"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#FFF8C5"/>
        <SolidColorBrush x:Key="Red"       Color="#CF222E"/>
        <SolidColorBrush x:Key="RedSoft"   Color="#FFEBE9"/>
        <SolidColorBrush x:Key="GraySoft"  Color="#EAEEF2"/>

        <!-- 圆角按钮 -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1F883D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A7F37"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#CF222E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#A40E26"/>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#1F2328"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0969DA"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 状态徽章 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- 节点卡片模板 -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="White"
                                BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,0,0,8"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0969DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <!-- 主布局：Header / 内容(左右两栏) / Footer -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部 Header ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="40" Height="40" CornerRadius="10" Background="#0969DA" VerticalAlignment="Center">
                    <TextBlock Text="C" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Clash 节点测速" FontSize="18" FontWeight="SemiBold" Foreground="#1F2328"/>
                    <TextBlock x:Name="TxtMeta" Text="正在连接 Clash 内核…" FontSize="12" Foreground="#656D76"/>
                </StackPanel>
            </StackPanel>
            <Border CornerRadius="12" Padding="12,5" VerticalAlignment="Center"
                    Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#656D76" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBadge" Text="空闲" Margin="6,0,0,0" FontSize="12" Foreground="#656D76"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ============ 中间内容：左主区 + 右侧栏 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 主区 ===== -->
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- 设置卡片 -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="测试设置" FontSize="14" FontWeight="SemiBold" Foreground="#1F2328" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="当前机场" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtAirline" Text="检测中…" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1F2328" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ShowDuration="30000"/>
                                </StackPanel>
                                <Button x:Name="BtnRescan" Grid.Column="1" Content="重新检测" Height="31" Padding="10,0"
                                        Background="White" Foreground="#1F2328" BorderBrush="#D0D7DE"
                                        BorderThickness="1" FontSize="12" Cursor="Hand" VerticalAlignment="Bottom"
                                        Click="OnRescan" Style="{StaticResource Btn}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="测速秒数" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSeconds" Text="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="最大下载 (MB)" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtMaxMb" Text="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="关键词过滤" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFilter"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="只测延迟" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkDelayOnly" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="测速源 URL" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtUrl" Text="https://speed.cloudflare.com/__down?bytes=52428800"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="BtnStart" Content="▶ 开始测速" Width="110" Height="32"
                                        Background="#1F883D" Foreground="White"
                                        BorderBrush="#1A7F37" BorderThickness="1"
                                        FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                                        Click="OnStart" Style="{StaticResource Btn}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A7F37"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnStop" Content="■ 停止" Width="90" Height="32"
                                        Background="#CF222E" Foreground="White" BorderThickness="1"
                                        BorderBrush="#A40E26" FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                                        Margin="10,0,0,0" IsEnabled="False" Click="OnStop" Style="{StaticResource Btn}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#A40E26"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnExport" Content="导出 CSV" Width="96" Height="32"
                                        Background="White" Foreground="#1F2328"
                                        BorderBrush="#D0D7DE" BorderThickness="1"
                                        Margin="10,0,0,0" FontSize="13" Cursor="Hand" Click="OnExport" Style="{StaticResource Btn}"/>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 进度卡片 -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Padding="16,12" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="TxtProgress" Text="就绪 · 等待开始" FontSize="13" Foreground="#1F2328"
                                       DockPanel.Dock="Left" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtCurrent" Text="" FontSize="12" Foreground="#656D76"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>
                        <ProgressBar x:Name="Progress" Height="6" Maximum="1" Value="0"
                                     Background="#EAEEF2" Foreground="#1F883D" BorderThickness="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border CornerRadius="3" Background="#EAEEF2"/>
                                        <Border x:Name="PART_Track"/>
                                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="#1F883D"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- 节点列表（卡片流） -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,12,16,10"
                                BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="节点列表" FontSize="14" FontWeight="SemiBold" Foreground="#1F2328"
                                           DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtListCount" Text="" FontSize="12" Foreground="#656D76"
                                           DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Grid Margin="14,12,14,12">
                            <ListView x:Name="LstNodes">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" MinHeight="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧状态色条 -->
                                            <Border x:Name="LeftBar" Grid.Column="0" CornerRadius="3,0,0,3" Background="#D0D7DE"/>

                                            <!-- 排名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding RankText}" FontSize="18"
                                                       FontWeight="Bold" Foreground="#656D76"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- 节点 + 类型 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1F2328" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#656D76" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 延迟 -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="延迟" FontSize="10" Foreground="#656D76"/>
                                                <TextBlock Text="{Binding DelayText}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1F2328" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 下载速度 -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="下载速度" FontSize="10" Foreground="#656D76"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpeedText}" FontSize="14" FontWeight="Bold"
                                                           Foreground="#1F2328" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 状态徽章 -->
                                            <Border Grid.Column="5" Style="{StaticResource Badge}" Margin="0,0,8,0"
                                                    Background="{Binding StatusBg}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusFg}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusText}"/>
                                            </Border>

                                            <!-- 重测按钮（仅 error 节点显示） -->
                                            <Button Grid.Column="6" Content="重测" Height="26" Padding="8,0"
                                                    Background="#FFF8C5" Foreground="#9A6700" BorderThickness="0"
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding RetestVisibility}"
                                                    Tag="{Binding Name}"
                                                    Click="OnRetest"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FBE6A6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 使用按钮（测速成功后显示） -->
                                            <Button Grid.Column="6" Content="{Binding UseButtonText}" Height="26" Padding="8,0"
                                                    Background="#1F883D" Foreground="White" BorderThickness="0"
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding UseVisibility}"
                                                    IsEnabled="{Binding IsUseEnabled}"
                                                    Tag="{Binding Name}"
                                                    Click="OnUseNode"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1A7F37"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.65"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ===== 右侧栏 ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                        <TextBlock Text="实时信息" FontSize="14" FontWeight="SemiBold" Foreground="#1F2328"/>
                    </Border>
                    <StackPanel Margin="14,12,14,12">
                        <!-- 当前测试 -->
                        <TextBlock Text="当前测试" FontSize="11" Foreground="#656D76"/>
                        <TextBlock x:Name="TxtSideCurrent" Text="—" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1F2328" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <!-- 最快节点 -->
                        <Border x:Name="RecoBox" Background="#DAFBE1" BorderBrush="#1A7F37" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🏆 最快节点" FontSize="11" Foreground="#1A7F37" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtBestName" Text="" FontSize="14" FontWeight="Bold"
                                           Foreground="#1F2328" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtBestMeta" Text="" FontSize="11" Foreground="#1A7F37" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BtnUseBest" Content="切换到此节点" Height="28"
                                            Background="#1F883D" Foreground="White" BorderThickness="0"
                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnUseBest"
                                            Padding="10,0" Style="{StaticResource Btn}"/>
                                    <Button x:Name="BtnCopy" Content="复制名称" Height="28" Margin="8,0,0,0"
                                            Background="White" Foreground="#1F2328" BorderBrush="#AFB8C1"
                                            BorderThickness="1" FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand" Click="OnCopyBest" Padding="10,0" Style="{StaticResource Btn}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 连接信息 -->
                        <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="本地端口" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtPort" Text="—" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2328" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="当前机场" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtGroup" Text="—" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2328" DockPanel.Dock="Right" MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 进度小卡 -->
                        <Border Background="#F6F8FA" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="已完成" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="TxtDone" Text="0 / 0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2328" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="成功率" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
