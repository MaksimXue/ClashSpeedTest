<Window x:Class="ClashSpeedTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash 节点测速"
        Icon="pack://application:,,,/app.ico"
        Height="860" Width="1320"
        MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        FontFamily="Segoe UI, Microsoft YaHei"
        Foreground="#1F2328"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ============ 通用 ============ -->
        <SolidColorBrush x:Key="BgWindow"  Color="#F6F8FA"/>
        <SolidColorBrush x:Key="BgCard"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubtle"  Color="#F6F8FA"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="BorderMid"  Color="#AFB8C1"/>
        <SolidColorBrush x:Key="FgPrimary" Color="#1F2328"/>
        <SolidColorBrush x:Key="FgSecondary" Color="#656D76"/>
        <SolidColorBrush x:Key="Accent"    Color="#0969DA"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#DDEBF6"/>
        <SolidColorBrush x:Key="Green"     Color="#1A7F37"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#DAFBE1"/>
        <SolidColorBrush x:Key="Orange"    Color="#9A6700"/>
        <SolidColorBrush x:Key="OrangeSoft" Color="#FFF8C5"/>
        <SolidColorBrush x:Key="Red"       Color="#CF222E"/>
        <SolidColorBrush x:Key="RedSoft"   Color="#FFEBE9"/>
        <SolidColorBrush x:Key="GraySoft"  Color="#EAEEF2"/>

        <!-- 圆角按钮（基础） -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作按钮组：统一外观（高度/圆角/字号一致），仅颜色区分 -->
        <Style x:Key="BtnAction" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#1F2328"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0969DA"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 状态徽章 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 右侧信息块 -->
        <Style x:Key="InfoBlock" TargetType="Border">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 节点条目：整行可点击切换"是否检测" -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="White"
                                BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,0,0,8"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FAFBFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0969DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <!-- 主布局：Header / 内容(左主区 + 右信息栏) -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部 Header（精简：仅标题与连接状态） ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border Width="36" Height="36" CornerRadius="9" Background="#0969DA" VerticalAlignment="Center">
                <TextBlock Text="C" FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Clash 节点测速" FontSize="17" FontWeight="SemiBold" Foreground="#1F2328"/>
                <TextBlock x:Name="TxtMeta" Text="正在连接 Clash 内核…" FontSize="12" Foreground="#656D76"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左主区 ===== -->
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- 测试设置（精简为两行：按钮组上移，测速源 URL 并入第二行） -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="测试设置" FontSize="14" FontWeight="SemiBold" Foreground="#1F2328" Margin="0,0,0,12"/>

                        <!-- 行1：当前机场 + 操作按钮组（统一外观） -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="当前机场" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtAirline" Text="检测中…" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1F2328" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="30000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="BtnRescan" Content="重新检测"
                                        Style="{StaticResource BtnAction}" Margin="0"
                                        Click="OnRescan"/>
                                <Button x:Name="BtnStart" Content="▶ 开始测速"
                                        Style="{StaticResource BtnAction}"
                                        Background="#1F883D" Foreground="White" BorderBrush="#1A7F37"
                                        Click="OnStart"/>
                                <Button x:Name="BtnStop" Content="■ 停止"
                                        Style="{StaticResource BtnAction}"
                                        Background="#CF222E" Foreground="White" BorderBrush="#A40E26"
                                        IsEnabled="False" Click="OnStop"/>
                                <Button x:Name="BtnExport" Content="导出 CSV"
                                        Style="{StaticResource BtnAction}"
                                        Click="OnExport"/>
                            </StackPanel>
                        </Grid>

                        <!-- 行2：测速秒数 / 最大下载 / 测速源 URL / 只测延迟 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="124"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="测速秒数" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSeconds" Text="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="最大下载 (MB)" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMaxMb" Text="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="测速源 URL" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtUrl" Text="https://speed.cloudflare.com/__down?bytes=52428800"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="只测延迟" FontSize="11" Foreground="#656D76" Margin="0,0,0,4"/>
                                <CheckBox x:Name="ChkDelayOnly" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 节点列表（占满剩余空间） -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,12,16,10"
                                BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="节点列表" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1F2328" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="点击条目可切换是否检测" FontSize="11"
                                           Foreground="#9AA4AE" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Grid.Column="2" x:Name="TxtListCount" Text="要检测 0 / 共 0"
                                           FontSize="12" Foreground="#656D76" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Margin="12,10,12,10">
                            <ListView x:Name="LstNodes" PreviewMouseLeftButtonUp="OnNodeRowClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0" MinHeight="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧色条：绿色=要检测，灰色=不检测 -->
                                            <Border Grid.Column="0" CornerRadius="3,0,0,3"
                                                    Background="{Binding SelectionBar}"/>

                                            <!-- 排名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding RankText}" FontSize="18"
                                                       FontWeight="Bold" Foreground="#656D76"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- 节点 + 类型 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1F2328" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#656D76" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 延迟 -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="延迟" FontSize="10" Foreground="#656D76"/>
                                                <TextBlock Text="{Binding DelayText}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1F2328" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 下载速度 -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="下载速度" FontSize="10" Foreground="#656D76"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpeedText}" FontSize="14" FontWeight="Bold"
                                                           Foreground="#1F2328" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 状态徽章 -->
                                            <Border Grid.Column="5" Style="{StaticResource Badge}" Margin="0,0,8,0"
                                                    Background="{Binding StatusBg}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusFg}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusText}"/>
                                            </Border>

                                            <!-- 重测按钮（仅 error 节点显示） -->
                                            <Button Grid.Column="6" Content="重测" Height="26" Padding="8,0"
                                                    Background="#FFF8C5" Foreground="#9A6700" BorderThickness="0"
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding RetestVisibility}"
                                                    Tag="{Binding Name}"
                                                    Click="OnRetest"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FBE6A6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 使用按钮（测速成功后显示） -->
                                            <Button Grid.Column="6" Content="{Binding UseButtonText}" Height="26" Padding="8,0"
                                                    Background="#1F883D" Foreground="White" BorderThickness="0"
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding UseVisibility}"
                                                    IsEnabled="{Binding IsUseEnabled}"
                                                    Tag="{Binding Name}"
                                                    Click="OnUseNode"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1A7F37"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.65"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ===== 右侧：实时信息（合并状态 + 进度 + 底部状态栏） ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                        <TextBlock Text="实时信息" FontSize="14" FontWeight="SemiBold" Foreground="#1F2328"/>
                    </Border>

                    <!-- 底部状态栏（从窗口底部移入此处） -->
                    <Border DockPanel.Dock="Bottom" Padding="12,10" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
                            Background="#F6F8FA">
                        <TextBlock x:Name="TxtFooter" Text="就绪" FontSize="12" Foreground="#656D76"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,12,14,12">
                            <!-- 运行状态 -->
                            <Border Style="{StaticResource InfoBlock}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="状态" FontSize="11" Foreground="#656D76"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#656D76" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBadge" Text="空闲" Margin="6,0,0,0" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#656D76"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 进度 -->
                            <Border Style="{StaticResource InfoBlock}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="进度" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtProgress" Text="就绪 · 等待开始" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#1F2328" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="Progress" Height="6" Maximum="1" Value="0"
                                                 Background="#EAEEF2" Foreground="#1F883D" BorderThickness="0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border CornerRadius="3" Background="#EAEEF2"/>
                                                    <Border x:Name="PART_Track"/>
                                                    <Border x:Name="PART_Indicator" CornerRadius="3" Background="#1F883D"
                                                            HorizontalAlignment="Left"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="已完成" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtDone" Text="0 / 0" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1F2328" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="成功率" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtOkRate" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1F2328" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 当前测试 -->
                            <Border Style="{StaticResource InfoBlock}">
                                <StackPanel>
                                    <TextBlock Text="当前测试" FontSize="11" Foreground="#656D76"/>
                                    <TextBlock x:Name="TxtSideCurrent" Text="—" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1F2328" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 最快节点 -->
                            <Border x:Name="RecoBox" Background="#DAFBE1" BorderBrush="#1A7F37" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="🏆 最快节点" FontSize="11" Foreground="#1A7F37" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtBestName" Text="" FontSize="14" FontWeight="Bold"
                                               Foreground="#1F2328" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtBestMeta" Text="" FontSize="11" Foreground="#1A7F37" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="BtnUseBest" Content="切换到此节点" Height="28"
                                                Background="#1F883D" Foreground="White" BorderThickness="0"
                                                FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnUseBest"
                                                Padding="10,0" Style="{StaticResource Btn}"/>
                                        <Button x:Name="BtnCopy" Content="复制名称" Height="28" Margin="8,0,0,0"
                                                Background="White" Foreground="#1F2328" BorderBrush="#AFB8C1"
                                                BorderThickness="1" FontSize="11" FontWeight="SemiBold"
                                                Cursor="Hand" Click="OnCopyBest" Padding="10,0" Style="{StaticResource Btn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 连接信息 -->
                            <Border Style="{StaticResource InfoBlock}" Margin="0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="本地端口" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtPort" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1F2328" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="当前机场" FontSize="11" Foreground="#656D76" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtGroup" Text="—" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1F2328" DockPanel.Dock="Right" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
